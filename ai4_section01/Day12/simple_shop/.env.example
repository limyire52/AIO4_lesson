# Supabase 프로젝트의 URL을 입력하세요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# 서버 전용 service_role 키입니다. 브라우저나 GitHub에 공개하지 마세요.
# RLS를 우회하는 키이므로 회원별 접근 권한은 FastAPI에서 확인합니다.
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# 아래 실행 안내의 명령으로 생성한 무작위 문자열을 입력하세요.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# 로그인 유효 시간: 분 단위입니다.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 로컬 HTTP에서는 false, Render의 HTTPS에서는 true로 설정합니다.
COOKIE_SECURE=false
